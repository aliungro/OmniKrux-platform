    "expected": "1000"
  },
  {
    "name": "whole_number",
    "message": "{{value}}",
    "labels": {},
    "value": 100.0,
    "expected": "100"
  },
  {
    "name": "zero",
    "message": "{{value}}",
    "labels": {},
    "value": 0.0,
    "expected": "0"
  },
  {
    "name": "negative",
    "message": "{{value}}",
    "labels": {},
    "value": -2.5,
    "expected": "-2.5"
  },
  {
    "name": "small_has_no_exponent",
    "message": "{{value}}",
    "labels": {},
