{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "uid": "api-lat",
  "title": "API latency",
  "schemaVersion": 22,
  "version": 3,
  "refresh": "5s",
  "tags": [
    "api"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 2,
      "type": "graph",
      "title": "p95 latency",
      "datasource": "${DS_PROM}",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "yaxes": [
        {
          "format": "s"
        },
        {
          "format": "short"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "alert": {
        "name": "p95 too slow",
        "message": "p95 above 300 ms",
        "for": "5m",
        "frequency": "60s",
        "handler": 1,
        "noDataState": "no_data",
        "executionErrorState": "alerting",
        "notifications": [
          {
            "uid": "slack-1"
          }
        ],
        "conditions": [
          {
            "type": "query",
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "type": "avg",
              "params": []
            },
            "evaluator": {
              "type": "gt",
              "params": [
                0.3
              ]
            },
            "operator": {
              "type": "and"
            }
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests per second",
      "datasource": "${DS_PROM}",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"$job\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Error ratio",
      "datasource": "${DS_PROM}",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"$job\",code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"$job\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Requests by route",
      "datasource": "${DS_PROM}",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=\"$job\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "heatmap",
      "title": "Latency heatmap",
      "datasource": "${DS_PROM}",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])) by (le)"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": "${DS_PROM}",
        "query": "label_values(up, job)",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "api",
          "value": "api"
        }
      }
    ]
  }
}
